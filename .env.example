# ProjectOS is a CLI-first, local, in-process application.
# There is no HTTP server, so no PORT or CORS configuration exists.

NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/projectos

PROJECTOS_WORKSPACE_ROOT=/absolute/path/to/projects
PROJECTOS_CONFIG_PATH=.projectos/workspace.json
PROJECTOS_MAX_BUILDERS=5

AI_PROVIDER=codex
AI_MODEL=
AI_API_KEY=

LOG_LEVEL=info
