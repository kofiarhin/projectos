{
  "version": 1,
  "workspace": {
    "name": "My ProjectOS Workspace",
    "root": ".",
    "scanDepth": 1,
    "ignore": [".git", "node_modules", "dist", "build", ".projectos"]
  },
  "database": {
    "uriEnv": "MONGODB_URI"
  },
  "runtime": {
    "maxParallelBuilders": 5,
    "defaultProvider": "codex",
    "requireTaskApproval": true,
    "autoVerify": true
  },
  "morning": {
    "skipCompletedProjects": true,
    "generateMissingSpecifications": true,
    "generateMissingPlans": true,
    "idempotent": true
  },
  "safety": {
    "allowOutsideWorkspace": false,
    "allowSourceDeletion": false,
    "requireVerificationBeforeComplete": true
  }
}
